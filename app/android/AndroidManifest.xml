<?xml version="1.0" encoding="utf-8"?>
<!--
  VFX1 for Quest: DOS in DOSBox Pure with an emulated Forte VFX1, in OpenXR.
  A NativeActivity with no Java code; the native library is libvfx1quest.so.
  Built by app/android/build.sh. Sideload with adb.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fortevfx.vfx1quest"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="32" android:targetSdkVersion="32" />

    <uses-feature android:glEsVersion="0x00030001" android:required="true" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />

    <!-- fetching a game from the dev PC on first launch -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- OpenXR loader: find the runtime through the runtime broker -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
    </queries>

    <application
        android:label="VFX1 Quest"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:allowBackup="false">

        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s|questpro|quest2" />
        <meta-data android:name="com.oculus.intent.category.VR" android:value="vr_only" />

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:excludeFromRecents="false"
            android:resizeableActivity="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="vfx1quest" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
